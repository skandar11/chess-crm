# =============================================
# Telegram Bot
# =============================================
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Белый список Telegram User ID (через запятую). Оставить пустым чтобы пускать всех.
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# =============================================
# База данных PostgreSQL
# =============================================
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=chess_crm;Username=postgres;Password=your_password

# =============================================
# LM Studio — лучшая модель для генерации SQL (openai/gpt-oss-20b или sqlcoder-7b-2)
# =============================================
SQL_MODEL_API_URL=http://localhost:1234/v1/chat/completions
SQL_MODEL_NAME=sqlcoder-7b-2

# =============================================
# LM Studio — быстрая модель для форматирования ответа
# =============================================
CHAT_MODEL_API_URL=http://localhost:1234/v1/chat/completions
CHAT_MODEL_NAME=gemma-3-4b-it